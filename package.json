{
  "name": "express-xss-waf",
  "version": "1.0.0",
  "description": "Lightweight, configurable Express.js middleware for detecting and mitigating reflected and stored XSS payloads.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watchAll",
    "lint": "eslint .",
    "test:coverage": "jest --coverage --runInBand",
    "demo": "node demo.js"
  },
  "keywords": [
    "express",
    "xss",
    "waf",
    "security",
    "middleware",
    "web-application-firewall"
  ],
  "license": "MIT",
  "peerDependencies": {
    "express": ">=4.18.0 || >=5.0.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.0.0",
    "supertest": "^7.1.0"
  },
  "overrides": {
    "test-exclude": "8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "restoreMocks": true,
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
