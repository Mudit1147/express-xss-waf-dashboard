{
  "env": { "node": true, "jest": true, "es2022": true },
  "extends": [],
  "parserOptions": { "ecmaVersion": "latest" },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "semi": ["error", "always"],
    "quotes": ["error", "single", { "avoidEscape": true }]
  }
}
